<script webc:setup>
  // One chip, five surfaces. The markup was repeated in the standings, the
  // target cards, the variant list, the per-run pages and the run-history
  // table, each with its own screen-reader text.
  //
  // `slug` matters where a row is a run point: a point carries figures and a
  // date but not the identity of the target it belongs to, and without it the
  // baseline's definitional 0.0/100.0 grades like any other row.
</script>
<span :class="'grade-chip ' + (size || 'text-sm') + ' grade-' + gradeForRow(row, slug).band">
  <span aria-hidden="true" @text="gradeForRow(row, slug).letter ?? '–'"></span>
  <span class="sr-only" @text="'Grade ' + (gradeForRow(row, slug).letter ?? gradeForRow(row, slug).qualifier)"></span>
</span>
