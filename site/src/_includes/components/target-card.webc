<script webc:setup>
  function widthPct(v) { return (v == null ? 0 : v) + "%"; }
</script>
<div
  :class="'group rounded-xl border p-5 transition-colors ' + (row.synthesised ? 'bg-brand-50 dark:bg-brand-500/10 border-brand-200 dark:border-brand-500/30' : 'bg-zinc-50/70 dark:bg-white/[0.03] border-zinc-200 dark:border-white/10 hover:border-brand-300 dark:hover:border-brand-500/40')">
  <a :href="'/targets/' + row.slug" class="block">
  <div class="flex items-center justify-between gap-3 mb-3">
    <span class="font-semibold text-zinc-900 dark:text-zinc-50 group-hover:text-brand-700 dark:group-hover:text-brand-300 truncate" @text="row.display"></span>
    <span webc:if="row.synthesised" class="text-xs text-brand-700 dark:text-brand-300 font-medium shrink-0">ground truth</span>
    <span webc:elseif="row.movement.state === 'new'" class="shrink-0 inline-flex items-center rounded-full bg-brand-100 dark:bg-brand-500/20 px-2 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-200">new</span>
    <span webc:elseif="row.movement.state === 'carried'" class="text-xs text-zinc-500 dark:text-zinc-400 shrink-0" aria-hidden="true">–</span>
    <span webc:else :class="'shrink-0 inline-flex items-center gap-1 text-xs font-medium tnum move-' + row.movement.state">
      <span aria-hidden="true" @text="row.movement.arrow"></span>
      <span @text="row.movement.deltaLabel"></span>
      <span class="sr-only" @text="row.movement.label"></span>
    </span>
  </div>
  <!-- Grade first, matching the standings: the letter is derived from the
       card's own two figures at render time (gradeOf), the bar draws
       coverage alone, and the judgement lives in the chip. -->
  <div class="flex items-center gap-3">
    <span :class="'grade-chip text-sm grade-' + gradeOf(row.divergenceValue, row.coverageValue).band">
      <span aria-hidden="true" @text="gradeOf(row.divergenceValue, row.coverageValue).letter ?? '–'"></span>
      <span class="sr-only" @text="'Grade ' + (gradeOf(row.divergenceValue, row.coverageValue).letter ?? 'not scored')"></span>
    </span>
    <div
      class="flex-1 h-2.5 rounded-full bg-zinc-200 dark:bg-white/10 overflow-hidden"
      role="meter"
      aria-valuemin="0"
      aria-valuemax="100"
      :aria-valuenow="row.coverageValue == null ? 0 : row.coverageValue"
      :aria-label="row.display + ' implements ' + row.coverage + ' of the suite and diverges on ' + row.divergence">
      <div class="h-full rounded-full bg-zinc-400 dark:bg-zinc-400/80" :style="'width:' + widthPct(row.coverageValue)"></div>
    </div>
    <span class="w-28 text-right leading-tight">
      <span class="block font-mono font-bold tnum text-sm text-zinc-900 dark:text-zinc-100 whitespace-nowrap">
        <span @text="row.divergence"></span>
        <span class="font-sans font-normal text-xs text-zinc-500 dark:text-zinc-400">&nbsp;diverges</span>
      </span>
      <span class="block font-mono tnum text-xs text-zinc-500 dark:text-zinc-400">
        <span @text="row.coverage"></span>
        <span class="font-sans"> covered</span>
      </span>
      <!-- No regional cohort count here, for the reason the standings dropped
           it: the naive reading inverts it. But a zero is an absolute claim,
           so where the target carries a regional range the worst-region
           figure qualifies it in place; the target's page tells the
           per-region story properly. -->
      <span webc:if="row.divergenceValue === 0 && row.divergenceWorstLabel" class="block font-mono tnum text-[0.7rem] text-zinc-400 dark:text-zinc-500">
        ≤<span @text="row.divergenceWorstLabel"></span><span class="font-sans"> by region</span>
      </span>
    </span>
  </div>
  <div class="mt-2 text-xs font-mono text-zinc-500 dark:text-zinc-400 truncate" :title="row.version" @text="row.version"></div>
  </a>
  <!-- Builds of this project. Named rather than given cards of their own - a
       reader chooses between projects, and the build follows from where their
       code runs - but each still links to its own page, or nesting would make
       it unreachable from the one page a reader would look for it on. Outside
       the card's main link, because an anchor inside an anchor is invalid. -->
  <p webc:if="row.variants && row.variants.length" class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
    <span class="text-zinc-400 dark:text-zinc-500" aria-hidden="true">↳</span>
    <a webc:for="v of row.variants" :href="'/targets/' + v.slug"
      class="text-zinc-500 dark:text-zinc-400 underline decoration-dotted underline-offset-2 hover:text-brand-700 dark:hover:text-brand-300 transition-colors"
      :aria-label="row.display + ', ' + (configurationOf(v.slug) || v.display) + ' build, measured separately'"
      title="A build of the same project, measured separately.">
      <span @text="configurationOf(v.slug) || v.display"></span>
      <!-- The build's own grade and named figures. This line read "0.0% / 78.7%",
           two bare percentages a reader had to guess the order of. The cap is
           named rather than flagged: "(capped)" said a ceiling existed without
           saying where, and on a chip this size the letter is the whole point. -->
      <span class="font-mono tnum text-zinc-400 dark:text-zinc-500"
        @text="' · ' + (gradeOf(v.divergenceValue, v.coverageValue).letter ?? '–') + (gradeOf(v.divergenceValue, v.coverageValue).capAt ? ' (coverage cap)' : '') + ' · ' + v.divergence + ' diverges · ' + v.coverage + ' covered'"></span>
    </a>
  </p>
</div>
